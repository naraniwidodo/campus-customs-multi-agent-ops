# Campus Customs — Multi-Agent Operations
# Copy to .env and fill in. Never commit the real .env.

# Working-copy database. Resolved relative to the project root when not absolute.
# The seed (campus_customs.db) is never opened through this.
CAMPUS_DB_PATH=data/campus_customs_new.db

# Model for the agent team. Pinned for this assignment — do not change.
# This deliberately overrides PORTKEY_MODEL inherited from the parent .env,
# which is set to a different model.
MODEL_NAME=gpt-6-luna

# Portkey (OpenAI-compatible). The key is read from the parent .env; set it here
# only if you need to override.
# PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai

# Agent orchestration limits — keep runs cheap and prevent infinite loops.
# Each round is one Boss call plus the specialists it dispatches, run in parallel.
MAX_ITERATIONS=3
AGENT_RETRIES=2
